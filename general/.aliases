alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

export EDITOR=vim
export SCRCPY_OPTS="-w --turn-screen-off --bit-rate 8M"
#export TERM="xterm-kitty"

shopt -s autocd
shopt -s cdspell

# Apps aliases
alias heroicFLAT="flatpak run com.heroicgameslauncher.hgl"
alias sober="flatpak run org.vinegarhq.Sober"
alias mc=PolyMC
#alias spotify="env LD_PRELOAD=/usr/lib/spotify-adblock.so spotify --enable-features=UseOzonePlatform --ozone-platform=wayland"
alias emu_3DS="flatpak run org.azahar_emu.Azahar"
alias citra=emu_3DS
alias 3ds=citra
alias emu_DS="flatpak run org.desmume.DeSmuME"
alias desmume=emu_DS
alias ds=desmume
alias emu_GBA="/home/lucas/Games/pokemon/emulators/mGBA-0.10.5-appimage-x64.appimage"
alias gba=emu_GBA
alias phone="scrcpy -w --turn-screen-off"
alias mindustry="flatpak run com.github.Anuken.Mindustry"
alias apdoom="/home/lucas/comp/linux?/crispy-apdoom -game doom -apserver clxrk.duckdns.org:38281 -applayer doomguy"
alias sways="dbus-run-session sway --unsupported-gpu"

# Error correcting aliases
alias car="cat"
alias bim=vim

# Other aliases
alias get-m4a="yt-dlp -x --audio-format m4a -o ~/Music/track.m4a"
alias hypr="cd ~/.config/hypr"
alias get-mp4="yt-dlp -f bestvideo[ext=mp4]+bestaudio[ext=m4a]/mp4 -o ~/Videos/video.mp4"
alias e="exit"
alias :q="exit"
alias q=e
alias c="clear"
alias b="cd -"
alias nano=vim
alias vi=vim
alias wcp=wl-copy 
alias btw=fastfetch
alias ff=fastfetch
alias vrc="vim ~/.bashrc"
alias rl="source ~/.bashrc"
alias doas=sudo
alias py=python3
alias crispy"=cd /home/lucas/comp/linux?"
alias mk="make -j4 -l5"
alias smk="sudo make -j4 -l5"
