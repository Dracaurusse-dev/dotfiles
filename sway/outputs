### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
#output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill
output * bg ~/.config/Wallpapers/6354632.png fill
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
output HDMI-A-1 mode 1920x1080@144Hz position 0 0 allow_tearing yes max_render_time off
output eDP-1    mode 1920x1080@60Hz  position 1920 0

workspace $codeWP 	output HDMI-A-1
workspace $gameWP	output HDMI-A-1
workspace $discordWP    output eDP-1
workspace $browserWP    output eDP-1
workspace $musicWP      output eDP-1
